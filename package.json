{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@jack-yang/opencode-tps-meter",
  "version": "1.3.2",
  "description": "Live TPS/AVG/TTFT meter plugin for OpenCode TUI with color-coded speed tiers",
  "type": "module",
  "exports": {
    ".": {
      "import": "./tui.tsx"
    },
    "./tui": {
      "import": "./tui.tsx"
    }
  },
  "engines": {
    "opencode": ">=1.4.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.3",
    "@opentui/core": ">=0.4.2 <1",
    "@opentui/solid": ">=0.4.2 <1",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.17.11",
    "@opentui/core": "0.4.2",
    "@opentui/solid": "0.4.2",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --jsx react-jsx --jsxImportSource @opentui/solid --module esnext --target esnext --moduleResolution bundler --skipLibCheck tui.tsx measure.ts",
    "sync-region": "node scripts/sync-region.mjs",
    "smoke-install": "node scripts/smoke-install.mjs"
  },
  "files": [
    "tui.tsx",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "tps",
    "llm",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangwudong/opencode-tps-meter.git"
  },
  "homepage": "https://github.com/yangwudong/opencode-tps-meter#readme",
  "bugs": {
    "url": "https://github.com/yangwudong/opencode-tps-meter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "brace-expansion": "^5.0.12",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "seroval": "^1.6.8",
    "seroval-plugins": "^1.6.8",
    "toml": "^5.0.1",
    "zod": "^4.6.6",
    "source-map-js": "^1.2.2",
    "vite": "^7.3.7"
  }
}
